// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRADOR
  ADVOGADO
  COLABORADOR
}

enum TemplateStatus {
  RASCUNHO
  ATIVO
  INATIVO
}

enum TemplateCategory {
  CONTRATO
  PETICAO
  PROCURACAO
  NOTIFICACAO
  FICHA
  OUTRO
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(COLABORADOR)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  templatesCreated        Template[]        @relation("TemplateCreatedBy")
  templatesUpdated        Template[]        @relation("TemplateUpdatedBy")
  templateVersionsCreated TemplateVersion[] @relation("TemplateVersionCreatedBy")
  templateDraftsUpdated   TemplateDraft[]   @relation("TemplateDraftUpdatedBy")

  clientsResponsible Client[] @relation("ClientResponsible")

  attendanceFormsResponsible ClientAttendanceForm[] @relation("ClientAttendanceFormResponsible")
  attendanceFormsCreated     ClientAttendanceForm[] @relation("ClientAttendanceFormCreatedBy")
  attendanceFormsUpdated     ClientAttendanceForm[] @relation("ClientAttendanceFormUpdatedBy")
  attendanceFormsFinalized   ClientAttendanceForm[] @relation("ClientAttendanceFormFinalizedBy")


clientDocumentsUploaded ClientDocument[] @relation("ClientDocumentUploadedBy")
clientDocumentsUpdated  ClientDocument[] @relation("ClientDocumentUpdatedBy")

  @@index([deletedAt])
  @@map("users")
}

model Template {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(160)
  description String? @db.VarChar(500)

  category  TemplateCategory
  legalArea String?          @map("legal_area") @db.VarChar(80)
  status    TemplateStatus   @default(RASCUNHO)

  // Zero enquanto nenhuma versão foi publicada. Publicar incrementa.
  currentVersion Int @default(0) @map("current_version")

  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid

  createdBy User @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedBy User @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  versions TemplateVersion[]
  draft    TemplateDraft?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@index([category, deletedAt])
  @@index([legalArea, deletedAt])
  @@index([updatedAt])
  @@map("templates")
}

model TemplateVersion {
  id String @id @default(uuid()) @db.Uuid

  templateId String @map("template_id") @db.Uuid
  version    Int

  // Fonte de verdade do documento. O HTML é derivado no servidor.
  contentJson Json   @map("content_json")
  contentHtml String @map("content_html") @db.Text

  variables    Json
  signatures   Json
  pageSettings Json @map("page_settings")

  createdById String @map("created_by_id") @db.Uuid

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdBy User @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
  @@map("template_versions")
}

/// Rascunho mutável de um template. Existe no máximo um por template e é
/// sobrescrito pelo autosave. `revision` serve para detectar edição
/// concorrente: o cliente devolve a revisão que carregou e a action recusa
/// a gravação quando ela já avançou.
model TemplateDraft {
  id String @id @default(uuid()) @db.Uuid

  templateId String @unique @map("template_id") @db.Uuid
  revision   Int    @default(1)

  contentJson Json   @map("content_json")
  contentHtml String @map("content_html") @db.Text

  variables    Json
  signatures   Json
  pageSettings Json @map("page_settings")

  updatedById String @map("updated_by_id") @db.Uuid

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  updatedBy User @relation("TemplateDraftUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("template_drafts")
}

enum ClientType {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum ClientStatus {
  ATIVO
  PROSPECTO
  INATIVO
}

model Client {
  id String @id @default(uuid()) @db.Uuid

  /**
   * Nome completo para pessoa física.
   * Razão social para pessoa jurídica.
   */
  name String @db.VarChar(160)

  /**
   * Nome social da pessoa física ou nome fantasia da pessoa jurídica.
   */
  displayName String? @map("display_name") @db.VarChar(160)

  type   ClientType
  status ClientStatus @default(PROSPECTO)

  /**
   * CPF ou CNPJ contendo somente dígitos.
   * CPF: 11 caracteres.
   * CNPJ: 14 caracteres.
   * O tamanho e a validade devem ser verificados no schema Zod,
   * pois o Prisma não oferece uma constraint condicional baseada em `type`.
   */
  document String @unique @db.VarChar(14)

  /**
   * Campos específicos de pessoa física.
   */
  birthDate DateTime? @map("birth_date") @db.Date

  /**
   * Campos específicos de pessoa jurídica.
   */
  stateRegistration     String? @map("state_registration") @db.VarChar(30)
  municipalRegistration String? @map("municipal_registration") @db.VarChar(30)

  /**
   * Contatos principais.
   * Telefone deve ser salvo somente com dígitos.
   * O limite de 15 permite números no formato internacional.
   */
  email String? @db.VarChar(254)
  phone String? @db.VarChar(15)

  notes String? @db.Text

  /**
   * Advogado ou colaborador responsável pelo relacionamento.
   */
  responsibleId String @map("responsible_id") @db.Uuid

  responsible User @relation("ClientResponsible", fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  address ClientAddress?

  attendanceForms ClientAttendanceForm[] @relation("ClientAttendanceForms")
  documents       ClientDocument[]       @relation("ClientDocuments")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@index([type, deletedAt])
  @@index([responsibleId, deletedAt])
  @@index([name])
  @@index([email])
  @@index([updatedAt])
  @@map("clients")
}

model ClientAddress {
  id String @id @default(uuid()) @db.Uuid

  clientId String @unique @map("client_id") @db.Uuid

  postalCode String? @map("postal_code") @db.VarChar(8)
  street     String? @db.VarChar(160)
  number     String? @db.VarChar(30)
  complement String? @db.VarChar(100)
  district   String? @db.VarChar(100)
  city       String? @db.VarChar(100)
  state      String? @db.Char(2)
  country    String  @default("BR") @db.Char(2)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([city, state])
  @@map("client_addresses")
}

enum ClientDocumentCategory {
  IDENTIFICACAO
  CONTRATO
  PROCURACAO
  COMPROVANTE
  CORRESPONDENCIA
  DOCUMENTO_JURIDICO
  DOCUMENTO_FINANCEIRO
  OUTRO
}

enum ClientDocumentStatus {
  ATIVO
  ARQUIVADO
}

enum ClientDocumentSource {
  UPLOAD
  TEMPLATE
  IMPORTACAO
}

enum ClientDocumentVisibility {
  EQUIPE
  CLIENTE
  CONFIDENCIAL
}

/// Documento armazenado no arquivo geral do cliente.
///
/// O arquivo físico deve permanecer em um storage externo. Este modelo
/// guarda os metadados necessários para busca, controle de acesso,
/// auditoria e recuperação do arquivo.
model ClientDocument {
  id String @id @default(uuid()) @db.Uuid

  clientId String @map("client_id") @db.Uuid

  client Client @relation("ClientDocuments",fields: [clientId],references: [id],onDelete: Restrict,onUpdate: Cascade)

  title       String  @db.VarChar(200)
  description String? @db.VarChar(500)

  category   ClientDocumentCategory
  status     ClientDocumentStatus     @default(ATIVO)
  source     ClientDocumentSource     @default(UPLOAD)
  visibility ClientDocumentVisibility @default(EQUIPE)

  /// Data indicada no próprio documento. É diferente da data de upload.
  documentDate DateTime? @map("document_date") @db.Date

  /// Chave única do arquivo no storage.
  storageKey String @unique @map("storage_key") @db.VarChar(500)

  originalName String @map("original_name") @db.VarChar(255)
  mimeType     String @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt @map("size_bytes")

  /// Hash SHA-256 opcional para verificação de integridade e duplicidade.
  checksum String? @db.VarChar(64)

  /// Tags livres usadas na busca e organização do arquivo.
  tags String[] @default([])

  uploadedById String @map("uploaded_by_id") @db.Uuid
  updatedById  String @map("updated_by_id") @db.Uuid

  uploadedBy User @relation("ClientDocumentUploadedBy",fields: [uploadedById],references: [id],onDelete: Restrict,onUpdate: Cascade)

  updatedBy User @relation("ClientDocumentUpdatedBy",fields: [updatedById],references: [id],onDelete: Restrict,onUpdate: Cascade)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([clientId, deletedAt])
  @@index([clientId, category, deletedAt])
  @@index([status, deletedAt])
  @@index([visibility, deletedAt])
  @@index([uploadedById])
  @@index([documentDate])
  @@index([createdAt])
  @@index([checksum])
  @@map("client_documents")
}

enum AttendanceFormStatus {
  RASCUNHO
  FINALIZADA
  CANCELADA
}

enum AttendanceChannel {
  PRESENCIAL
  TELEFONE
  VIDEOCHAMADA
  EMAIL
  WHATSAPP
  OUTRO
}

enum ClientAttendanceActionType {
  SOLICITAR_DOCUMENTOS
  ANALISAR_DOCUMENTOS
  SOLICITAR_INFORMACOES_COMPLEMENTARES
  CONSULTAR_PROCESSO_EXISTENTE

  REALIZAR_PESQUISA_JURIDICA
  ELABORAR_PARECER
  ELABORAR_CONTRATO_OU_ADITIVO
  ELABORAR_NOTIFICACAO_EXTRAJUDICIAL

  ELABORAR_PETICAO
  PROPOR_ACAO_JUDICIAL
  APRESENTAR_DEFESA
  ABRIR_PROCESSO_INTERNO

  AGENDAR_RETORNO
  ENVIAR_PROPOSTA_HONORARIOS
  ENCAMINHAR_OUTRA_AREA
  ENCERRAR_SEM_PROVIDENCIAS
}

model ClientAttendanceForm {
  id String @id @default(uuid()) @db.Uuid

  clientId String @map("client_id") @db.Uuid

  client Client @relation("ClientAttendanceForms", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Snapshot imutável dos dados cadastrais existentes no momento da
  /// criação da ficha. Deve conter nome, documento, tipo, contatos e
  /// endereço. O layout continua exibindo o cadastro atual do cliente.
  clientSnapshot Json @map("client_snapshot")

  clientSnapshotVersion Int @default(1) @map("client_snapshot_version")

  status   AttendanceFormStatus @default(RASCUNHO)
  revision Int                  @default(1)

  /// Definido automaticamente pelo servidor ao criar a ficha.
  /// Não deve ser recebido como campo editável do formulário.
  attendanceAt DateTime @default(now()) @map("attendance_at") @db.Timestamptz(3)

  channel       AttendanceChannel?
  contactPerson String?            @map("contact_person") @db.VarChar(160)

  subject   String? @db.VarChar(180)
  legalArea String? @map("legal_area") @db.VarChar(80)

  /// Relato apresentado pelo cliente.
  clientReport String? @map("client_report") @db.Text

  /// Avaliação inicial realizada pelo advogado responsável.
  preliminaryAnalysis String? @map("preliminary_analysis") @db.Text

  /// O responsável é obtido da sessão autenticada no momento da criação.
  /// Não deve ser selecionável no formulário.
  responsibleId String @map("responsible_id") @db.Uuid

  responsible User @relation("ClientAttendanceFormResponsible", fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid

  createdBy User @relation("ClientAttendanceFormCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  updatedBy User @relation("ClientAttendanceFormUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  finalizedById String? @map("finalized_by_id") @db.Uuid

  finalizedBy User? @relation("ClientAttendanceFormFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(3)

  actions ClientAttendanceAction[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([clientId, deletedAt])
  @@index([responsibleId, deletedAt])
  @@index([status, deletedAt])
  @@index([attendanceAt])
  @@index([legalArea])
  @@index([updatedAt])
  @@map("client_attendance_forms")
}

/// Cada linha representa um checkbox selecionado na seção de
/// ações e encaminhamentos. A ausência da linha representa opção
/// não selecionada.
model ClientAttendanceAction {
  id String @id @default(uuid()) @db.Uuid

  attendanceFormId String                     @map("attendance_form_id") @db.Uuid
  type             ClientAttendanceActionType
  position         Int                        @default(0)

  attendanceForm ClientAttendanceForm @relation(fields: [attendanceFormId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([attendanceFormId, type])
  @@index([attendanceFormId, position])
  @@index([type])
  @@map("client_attendance_actions")
}
